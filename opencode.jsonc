{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "terraform fmt": "allow",
      "terraform fmt *": "allow",
      "terraform validate": "allow",
      "terraform validate *": "allow",
      "terraform init -backend=false": "allow",
      "terraform init -backend=false *": "allow",
      "terraform providers schema": "allow",
      "terraform providers schema *": "allow",
      "terraform version": "allow",
      "terraform version *": "allow",
      "rm .terraform.lock.hcl": "allow",
      "rm */.terraform.lock.hcl": "allow",
      "rm modules/*/.terraform.lock.hcl": "allow"
    }
  }
}
